{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dev-sweeper",
  "version": "0.2.0",
  "identifier": "com.devsweeper.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "dev-sweeper — 开发产物清理",
        "width": 1000,
        "height": 680,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "dev-sweeper",
    "category": "Utility",
    "shortDescription": "多生态开发产物扫描清理工具",
    "longDescription": "扫描 node_modules / target / venv 等开发产物，按大小和陈旧度排序，移入回收站（可恢复）。",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
